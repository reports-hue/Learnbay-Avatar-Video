# ── Server ─────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# ── Azure Speech (Avatar synthesis + TTS + word timings) ────────
# Resource must be in: westus2, westeurope, or southeastasia
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=westus2

# ── Azure OpenAI — Text (script, brand theme, company research) ─
AZURE_OPENAI_API_KEY=your_openai_key_here
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ── Azure OpenAI — Image (AI background generation) ─────────────
AZURE_IMAGE_API_KEY=your_image_key_here
AZURE_IMAGE_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_IMAGE_DEPLOYMENT=gpt-image-1

# ── Public URL ───────────────────────────────────────────────────
# Required when using ElevenLabs voices (Azure fetches the audio file)
# Must be publicly accessible. Example: https://app.yourdomain.com
PUBLIC_URL=https://your-domain.com

# ── Optional ─────────────────────────────────────────────────────
# ElevenLabs API key (only needed if using ElevenLabs voice option)
# ELEVENLABS_API_KEY=your_elevenlabs_key
